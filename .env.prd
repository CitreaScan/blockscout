PORT=4000

ETHEREUM_JSONRPC_VARIANT=geth
ETHEREUM_JSONRPC_HTTP_URL=http://citread:8085/

NETWORK=Citrea
SUBNETWORK=Testnet
CHAIN_ID=5115
COIN=cBTC
COIN_NAME=Citrea

API_V2_ENABLED=true
ECTO_USE_SSL=false
HEALTHY_BLOCKS_PERIOD=60

# Limitations
INDEXER_BLOCK_RANGES=5
INDEXER_MEMORY_LIMIT=4

INDEXER_BALANCE_BATCH_SIZE=30
COIN_BALANCE_BATCH_SIZE=30

# Balance Fetching
INDEXER_COIN_BALANCE_BATCH_SIZE=30
INDEXER_COIN_BALANCES_CONCURRENCY=3

# Receipts
INDEXER_RECEIPTS_BATCH_SIZE=30
INDEXER_RECEIPTS_CONCURRENCY=3

# Blocks
INDEXER_CATCHUP_BLOCKS_BATCH_SIZE=30
INDEXER_CATCHUP_BLOCKS_CONCURRENCY=3

# Internal Transactions
INDEXER_INTERNAL_TRANSACTIONS_BATCH_SIZE=30
INDEXER_INTERNAL_TRANSACTIONS_CONCURRENCY=3

# Tokens
INDEXER_TOKEN_BALANCES_BATCH_SIZE=30
INDEXER_TOKEN_BALANCES_CONCURRENCY=3

# Indexer
INDEXER_DISABLE_INTERNAL_TRANSACTIONS_FETCHER=false
INDEXER_DISABLE_PENDING_TRANSACTIONS_FETCHER=false

# Market/Price Data Configuration
MARKET_NATIVE_COIN_SOURCE=coin_gecko
MARKET_COINGECKO_COIN_ID=bitcoin
MARKET_COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Sourcify Integration
SOURCIFY_INTEGRATION_ENABLED=true
SOURCIFY_SERVER_URL=https://sourcify.dev/server
SOURCIFY_REPO_URL=https://repo.sourcify.dev/contracts

# Certified Contracts/Tokens
CONTRACT_CERTIFIED_LIST=0x1Dd3057888944ff1f914626aB4BD47Dc8b6285Fe

# Smart Contract Verifier Microservice
MICROSERVICE_SC_VERIFIER_ENABLED=true
MICROSERVICE_SC_VERIFIER_URL=https://eth-bytecode-db.services.blockscout.com/
MICROSERVICE_SC_VERIFIER_TYPE=eth_bytecode_db
